# Dockerfile.oakhaven — thin overlay that bakes the OakHaven (qwen3.8-max) text-causal arch
# onto a Dynamo vLLM runtime image. Build the base first (render.py --framework vllm --target
# runtime, on the v0.26.0 pin in container/context.yaml), then layer this.
#
#   docker buildx build --platform linux/arm64 \
#     --build-arg BASE=<registry>/dynamo:oakhaven-vllm-v0.26.0-base-arm64 \
#     -f container/Dockerfile.oakhaven \
#     -t <registry>/dynamo:oakhaven-vllm-v0.26.0-arm64 --push container/
#
# WHY: OakHaven's checkpoint is architectures=["Qwen3_5MoeForCausalLM"] / model_type
# qwen3_5_moe_text (flat, text-only). vLLM v0.26.0 registers only the multimodal
# Qwen3_5MoeForConditionalGeneration, so `vllm serve` fails "architecture not supported".
# The patch registers the text arch + marks Qwen3_5ForCausalLMBase IsHybrid (so the Mamba/GDN
# `align` + hybrid-KV path triggers). qwen3.5-397b/122b need NONE of this (native).
#
# METHOD: full-file copy (NOT `git apply`) — the vLLM/Dynamo runtime images ship no `git` or
# `patch` binary (verified on vllm/vllm-openai:v0.26.0). The vendored files are cut from the
# v0.26.0 base (registry.py + the 2-line add; qwen3_5.py unchanged v0.26.0->main), so copying
# them over stock v0.26.0 is exact. The RUN self-verifies the arch marker, so any base drift
# fails the build loudly. See container/patches/oakhaven/{README.md,qwen3_5-moe-text-causal-arch.patch}.
ARG BASE
FROM ${BASE}

USER root
COPY patches/oakhaven/vllm_v0.26.0/vllm/model_executor/models/qwen3_5.py  /tmp/oak/qwen3_5.py
COPY patches/oakhaven/vllm_v0.26.0/vllm/model_executor/models/registry.py /tmp/oak/registry.py

RUN set -eu; \
    VDIR="$(python3 -c 'import vllm, os; print(os.path.dirname(vllm.__file__))')"; \
    echo "vllm package: $VDIR"; \
    install -m0644 /tmp/oak/qwen3_5.py  "$VDIR/model_executor/models/qwen3_5.py"; \
    install -m0644 /tmp/oak/registry.py "$VDIR/model_executor/models/registry.py"; \
    rm -rf /tmp/oak; \
    python3 - <<'PY'
from vllm.model_executor.models.registry import ModelRegistry as M
archs = set(M.get_supported_archs())
assert "Qwen3_5MoeForCausalLM" in archs, "OakHaven marker FAILED: Qwen3_5MoeForCausalLM not registered"
import importlib
m = importlib.import_module("vllm.model_executor.models.qwen3_5")
assert hasattr(m, "Qwen3_5MoeForCausalLM"), "OakHaven marker FAILED: class missing"
print("OakHaven marker OK: Qwen3_5MoeForCausalLM registered + qwen3_5 imports")
PY

# Restore the base image's non-root user (Dynamo runtime runs as `dynamo`, UID 1000).
USER 1000
